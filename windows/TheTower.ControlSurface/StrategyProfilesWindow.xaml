<Window x:Class="TheTower.ControlSurface.StrategyProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategy Profiles"
        Width="1040" Height="740" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E16" Foreground="#EDF2F7"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Strategy Profiles" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Clone a Farm profile, validate its compact settings, and publish a generated plan. Publishing never activates the profile."
                 Foreground="#93A4BB" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#111827" BorderBrush="#263349"
              BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="AVAILABLE PROFILES" Foreground="#62D5FF"
                     FontSize="10" FontWeight="Bold" Margin="4,2,4,8" />
          <ListBox Grid.Row="1" x:Name="ProfilesList"
                   Background="#0D1420" BorderBrush="#263349"
                   Foreground="#EDF2F7"
                   SelectionChanged="ProfilesList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="7,6">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Foreground="#93A4BB" FontSize="11">
                    <Run Text="{Binding Id}" />
                    <Run Text="  •  v" />
                    <Run Text="{Binding Version}" />
                  </TextBlock>
                  <TextBlock Text="{Binding OriginLabel}" Foreground="#7890AC"
                             FontSize="10" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="New Farm profile"
                    Click="NewProfile_Click" />
            <Button Grid.Column="1" x:Name="CloneButton"
                    Content="Clone selected" Click="CloneProfile_Click"
                    IsEnabled="False" />
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <Border Grid.Column="2" Background="#111827" BorderBrush="#263349"
              BorderThickness="1" CornerRadius="8" Padding="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="EditorPanel" IsEnabled="False">
            <TextBlock x:Name="EditorTitle" Text="Select or create a Farm profile"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="EditorHelpText"
                       Text="Bundled profiles are read-only; clone one to create an editable custom profile."
                       Foreground="#93A4BB" TextWrapping="Wrap" Margin="0,4,0,12" />

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Profile ID" VerticalAlignment="Center"
                         Foreground="#C8D5E6" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProfileIdBox"
                       Margin="4" ToolTip="Lowercase letters, digits, and underscores. The ID cannot be renamed after publication." />
              <TextBlock Grid.Row="1" Text="Display name" VerticalAlignment="Center"
                         Foreground="#C8D5E6" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="DisplayNameBox"
                       Margin="4" />
              <TextBlock Grid.Row="2" Text="Tier" VerticalAlignment="Center"
                         Foreground="#C8D5E6" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="TierBox"
                       Margin="4" MaxLength="3" />
            </Grid>

            <TextBlock Text="LOADOUT POLICIES" Foreground="#62D5FF"
                       FontSize="10" FontWeight="Bold" Margin="0,2,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Modules" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModulesModeBox"
                        Margin="4" SelectionChanged="PolicyMode_SelectionChanged" />
              <ComboBox Grid.Row="0" Grid.Column="2" x:Name="ModulesPresetBox"
                        Margin="4" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />

              <TextBlock Grid.Row="1" Text="Damage Slider" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DamageModeBox"
                        Margin="4" SelectionChanged="PolicyMode_SelectionChanged" />
              <TextBox Grid.Row="1" Grid.Column="2" x:Name="DamageValueBox"
                       Margin="4" ToolTip="Examples: 100%, 1e-18, or 1E-22%." />

              <TextBlock Grid.Row="2" Text="Orb Distance" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" x:Name="OrbModeBox"
                        Margin="4" SelectionChanged="PolicyMode_SelectionChanged" />
              <ComboBox Grid.Row="2" Grid.Column="2" x:Name="OrbPresetBox"
                        Margin="4" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />

              <TextBlock Grid.Row="3" Text="Target Priority" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TargetModeBox"
                        Margin="4" SelectionChanged="PolicyMode_SelectionChanged" />
              <ComboBox Grid.Row="3" Grid.Column="2" x:Name="TargetPresetBox"
                        Margin="4" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />
            </Grid>

            <Border Background="#0D1420" BorderBrush="#263349"
                    BorderThickness="1" CornerRadius="7" Padding="11"
                    Margin="0,16,0,0">
              <TextBlock x:Name="ValidationSummaryText"
                         Text="Validate the draft to preview its resolved generated plan."
                         Foreground="#C8D5E6" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Loading profile catalog..."
               Foreground="#93A4BB" TextWrapping="Wrap" Margin="2,0,2,10" />

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Published profiles become selectable, but use the main Controls pane to activate one."
                 Foreground="#93A4BB" FontSize="11" VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Grid.Column="1" x:Name="ValidateButton" Content="Validate draft"
              Click="Validate_Click" IsEnabled="False" />
      <Button Grid.Column="2" Content="Close" Click="Close_Click" />
      <Button Grid.Column="3" x:Name="PublishButton" Content="Publish profile"
              Click="Publish_Click" Style="{StaticResource PrimaryButton}"
              IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
