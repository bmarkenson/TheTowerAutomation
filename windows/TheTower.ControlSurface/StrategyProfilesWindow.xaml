<Window x:Class="TheTower.ControlSurface.StrategyProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategy Authoring"
        Width="1320" Height="880" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E16" Foreground="#EDF2F7"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Strategy Authoring" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Edit sparse Base and Strategy source, review effective values and provenance, then publish without activating a Strategy."
                 Foreground="#93A4BB" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="315" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#111827" BorderBrush="#263349"
              BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="BASES" Foreground="#62D5FF"
                     FontSize="11" FontWeight="Bold" Margin="4,2,4,7" />
          <ListBox Grid.Row="1" x:Name="BasesList"
                   AutomationProperties.Name="Base catalog"
                   Background="#0D1420" BorderBrush="#263349"
                   Foreground="#EDF2F7"
                   SelectionChanged="BasesList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="7,6">
                  <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Id, Mode=OneWay}" Foreground="#93A4BB" FontSize="11" />
                  <TextBlock Text="{Binding RevisionLabel, Mode=OneWay}" Foreground="#7890AC"
                             FontSize="10" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Text="STRATEGIES" Foreground="#62D5FF"
                     FontSize="11" FontWeight="Bold" Margin="4,13,4,7" />
          <ListBox Grid.Row="3" x:Name="StrategiesList"
                   AutomationProperties.Name="Strategy catalog"
                   Background="#0D1420" BorderBrush="#263349"
                   Foreground="#EDF2F7"
                   SelectionChanged="StrategiesList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="7,6">
                  <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Id, Mode=OneWay}" Foreground="#93A4BB" FontSize="11" />
                  <TextBlock Text="{Binding VersionLabel, Mode=OneWay}" Foreground="#7890AC"
                             FontSize="10" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="4" Text="CAPTURED DRAFTS" Foreground="#62D5FF"
                     FontSize="11" FontWeight="Bold" Margin="4,13,4,7"
                     ToolTip="Save-backed drafts are immutable capture evidence until opened here and published through the normal review flow." />
          <ListBox Grid.Row="5" x:Name="CapturedDraftsList"
                   AutomationProperties.Name="Captured Strategy draft catalog"
                   Background="#0D1420" BorderBrush="#263349"
                   Foreground="#EDF2F7"
                   SelectionChanged="CapturedDraftsList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="7,6">
                  <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Id, Mode=OneWay}" Foreground="#93A4BB" FontSize="11" />
                  <TextBlock Text="{Binding DetailLabel, Mode=OneWay}" Foreground="#7890AC"
                             FontSize="10" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <WrapPanel Grid.Row="6" Margin="0,10,0,0">
            <Button x:Name="NewBaseButton" Content="New Base"
                    Click="NewBase_Click" />
            <Button x:Name="NewStrategyButton" Content="New Strategy"
                    Click="NewStrategy_Click" />
            <Button x:Name="CloneButton" Content="Clone Strategy"
                    Click="CloneStrategy_Click" IsEnabled="False" />
            <Button x:Name="HistoryButton" Content="History..."
                    Click="History_Click"
                    ToolTip="Review immutable custom-Strategy revisions, including retired lineages, without selecting or activating a Strategy." />
            <Button x:Name="RenameStrategyButton" Content="Rename Strategy"
                    Click="RenameStrategy_Click" IsEnabled="False"
                    ToolTip="Edit the display name, then use the normal reviewed publication flow. The stable ID does not change." />
            <Button x:Name="DeleteStrategyButton" Content="Delete Strategy..."
                    Click="DeleteStrategy_Click" IsEnabled="False"
                    Style="{StaticResource DangerButton}"
                    ToolTip="Retire a custom Strategy from active catalogs while retaining its immutable lineage for reviewed restoration from History." />
          </WrapPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <Border Grid.Column="2" Background="#111827" BorderBrush="#263349"
              BorderThickness="1" CornerRadius="8" Padding="15">
        <Grid x:Name="EditorPanel" IsEnabled="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock x:Name="EditorTitle" Text="Select a Base or Strategy"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="EditorHelpText"
                       Text="Bases and Strategies use the same setting registry but publish through separate operations."
                       Foreground="#93A4BB" TextWrapping="Wrap" Margin="0,4,0,10" />
          </StackPanel>

          <Border Grid.Row="1" x:Name="CapturedDraftEvidencePanel"
                  Visibility="Collapsed" Background="#10283A"
                  BorderBrush="#368DB6" BorderThickness="1"
                  CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="CAPTURED DRAFT EVIDENCE" Foreground="#62D5FF"
                         FontSize="10" FontWeight="Bold" />
              <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="CapturedDraftEvidenceText"
                           Foreground="#C8D5E6" FontFamily="Consolas"
                           FontSize="10" TextWrapping="Wrap" />
              </ScrollViewer>
            </StackPanel>
          </Border>

          <Border Grid.Row="2" x:Name="RebaseBanner" Visibility="Collapsed"
                  Background="#3A2C11" BorderBrush="#D9A441" BorderThickness="1"
                  CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ReviewRebaseButton"
                      Content="Review Base update..." Click="ReviewRebase_Click" />
              <TextBlock x:Name="RebaseBannerText" Foreground="#F4D184"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>

          <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="85" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="ID" VerticalAlignment="Center" Foreground="#C8D5E6" />
              <TextBox Grid.Column="1" x:Name="EntityIdBox" Margin="4"
                       ToolTip="Published IDs are immutable. Clone to choose another ID." />
              <TextBlock Grid.Column="2" Text="Display name" VerticalAlignment="Center"
                         Foreground="#C8D5E6" />
              <TextBox Grid.Column="3" x:Name="DisplayNameBox" Margin="4"
                       ToolTip="Rename a custom Strategy here, then Review &amp; Publish. Its stable ID remains unchanged." />
              <TextBlock Grid.Column="4" Text="Tier" VerticalAlignment="Center"
                         Foreground="#C8D5E6" />
              <TextBox Grid.Column="5" x:Name="TierBox" Margin="4" MaxLength="3" />
            </Grid>
            <DockPanel x:Name="BasePinPanel" Margin="0,4,0,0" Visibility="Collapsed">
              <TextBlock DockPanel.Dock="Left" Text="Pinned Base" Width="95"
                         VerticalAlignment="Center" Foreground="#C8D5E6" />
              <TextBlock x:Name="BasePinHelpText" DockPanel.Dock="Right" Width="330"
                         Margin="10,0,0,0" VerticalAlignment="Center"
                         Foreground="#93A4BB" TextWrapping="Wrap" />
              <ComboBox x:Name="BasePinBox" DisplayMemberPath="DisplayName"
                        SelectionChanged="BasePin_SelectionChanged" Margin="4,0"
                        MinWidth="230" />
            </DockPanel>
          </StackPanel>

          <DockPanel Grid.Row="4" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton x:Name="ShowActiveOnlyButton" Content="Show active only"
                           GroupName="SettingFilter" IsChecked="True"
                           Checked="SettingFilter_Changed" Margin="7,0" />
              <RadioButton x:Name="ShowAllSettingsButton" Content="Show all settings"
                           GroupName="SettingFilter" Checked="SettingFilter_Changed"
                           Margin="7,0" />
            </StackPanel>
            <TextBlock Text="SETTINGS" Foreground="#62D5FF"
                       FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
          </DockPanel>

          <ListView Grid.Row="5" x:Name="SettingsList"
                    Background="#0D1420" BorderBrush="#263349"
                    Foreground="#EDF2F7"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border Background="#172235" Padding="9,6" Margin="0,8,0,3">
                      <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="#62D5FF"
                                 FontWeight="Bold" />
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#263349" BorderThickness="0,0,0,1"
                        Padding="9,9" MinWidth="690">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="185" />
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.RowSpan="3">
                      <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Id, Mode=OneWay}" Foreground="#7890AC" FontSize="10" />
                      <TextBlock Text="{Binding CapabilityDisplay, Mode=OneWay}" Foreground="#93A4BB"
                                 FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSourceStates, Mode=OneWay}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedSourceState, Mode=TwoWay}"
                              IsEnabled="{Binding SourceStateEnabled, Mode=OneWay}" Margin="5,0" />
                    <Button Grid.Row="1" Grid.Column="1" Content="Reset to inherited"
                            Visibility="{Binding CanResetToInherited, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                            Click="ResetToInherited_Click" Margin="5,4" />

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                      <TextBlock>
                        <Run Text="Effective: " Foreground="#93A4BB" />
                        <Run Text="{Binding EffectivePolicyDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" • " Foreground="#7890AC" />
                        <Run Text="{Binding EffectiveValueDisplay, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding ProvenanceDisplay, Mode=OneWay}" Foreground="#93A4BB"
                                 FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding PendingEffectiveDisplay, Mode=OneWay}" Foreground="#F1BF5B"
                                 FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Margin="8,7,0,0">
                      <TextBlock Text="{Binding FixedValueDisplay, Mode=OneWay}"
                                 FontWeight="SemiBold" TextWrapping="Wrap"
                                 Visibility="{Binding UsesFixedValueEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />

                      <ComboBox ItemsSource="{Binding PresetOptions, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                IsEnabled="{Binding PresetControlEnabled, Mode=OneWay}"
                                Visibility="{Binding UsesPresetEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />

                      <StackPanel Visibility="{Binding UsesPresetOrLocalEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <ComboBox ItemsSource="{Binding DefinitionForms, Mode=OneWay}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedDefinitionForm, Mode=TwoWay}"
                                  IsEnabled="{Binding DefinitionFormControlEnabled, Mode=OneWay}"
                                  AutomationProperties.Name="Definition source" />
                        <ComboBox ItemsSource="{Binding PresetOptions, Mode=OneWay}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  IsEnabled="{Binding DefinitionPresetControlEnabled, Mode=OneWay}"
                                  Visibility="{Binding IsPresetDefinitionSelected, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                  Margin="0,4,0,0"
                                  AutomationProperties.Name="Shared preset" />
                        <Border Background="#111C2D" BorderBrush="#324661"
                                BorderThickness="1" CornerRadius="4" Padding="9"
                                Margin="0,6,0,0"
                                Visibility="{Binding ShowsModulePresetPreview, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                          <StackPanel>
                            <TextBlock Text="MODULE PRESET DEFINITION" Foreground="#62D5FF"
                                       FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding ModulePresetPreviewTitle, Mode=OneWay}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ModulePresetLifecycleDisplay, Mode=OneWay}"
                                       Foreground="#93A4BB" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,1,0,5" />
                            <ItemsControl ItemsSource="{Binding ModulePresetPreviewSlots, Mode=OneWay}"
                                          AutomationProperties.Name="Normalized eight-slot Module preset definition">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="165" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                               Foreground="#AAB8CB" />
                                    <TextBlock Grid.Column="1" Text="{Binding Module, Mode=OneWay}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Create variant..."
                                    Click="CreateModuleVariant_Click"
                                    IsEnabled="{Binding CanCreateModuleVariant, Mode=OneWay}"
                                    Visibility="{Binding ModulePresetManagementVisible, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                    HorizontalAlignment="Left" Margin="0,7,0,0"
                                    AutomationProperties.Name="Create Module preset variant" />
                          </StackPanel>
                        </Border>
                        <StackPanel IsEnabled="{Binding LocalDefinitionControlEnabled, Mode=OneWay}"
                                    Visibility="{Binding IsLocalDefinitionSelected, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                    Margin="0,5,0,0">
                          <ItemsControl ItemsSource="{Binding LocalDefinitionEditor.Fields, Mode=OneWay}"
                                        Visibility="{Binding LocalDefinitionEditor.UsesObjectEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                             VerticalAlignment="Center" />
                                  <ComboBox Grid.Column="1"
                                            ItemsSource="{Binding AvailableOptions, Mode=OneWay}"
                                            DisplayMemberPath="DisplayName"
                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                            IsEnabled="{Binding SelectionEnabled, Mode=OneWay}"
                                            Visibility="{Binding UsesChoiceEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                                  <TextBox Grid.Column="1"
                                           Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Visibility="{Binding UsesTextEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <StackPanel Visibility="{Binding LocalDefinitionEditor.UsesListEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                            <ListBox x:Name="LocalDefinitionList"
                                     ItemsSource="{Binding LocalDefinitionEditor.ListValues, Mode=OneWay}"
                                     DisplayMemberPath="DisplayName" Height="116" />
                            <ComboBox ItemsSource="{Binding LocalDefinitionEditor.AvailableListOptions, Mode=OneWay}"
                                      SelectedItem="{Binding LocalDefinitionEditor.SelectedListOption, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" Margin="0,4,0,2"
                                      Visibility="{Binding LocalDefinitionEditor.ListMembershipEditable, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                            <WrapPanel>
                              <Button Content="Add" Click="AddLocalDefinitionListItem_Click"
                                      IsEnabled="{Binding LocalDefinitionEditor.CanAddListItem, Mode=OneWay}"
                                      Visibility="{Binding LocalDefinitionEditor.ListMembershipEditable, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                              <Button Content="Remove" Click="RemoveLocalDefinitionListItem_Click"
                                      IsEnabled="{Binding LocalDefinitionEditor.CanRemoveListItem, Mode=OneWay}"
                                      Visibility="{Binding LocalDefinitionEditor.ListMembershipEditable, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                      CommandParameter="{Binding SelectedItem, ElementName=LocalDefinitionList}" />
                              <Button Content="Move up" Click="MoveLocalDefinitionListItemUp_Click"
                                      IsEnabled="{Binding LocalDefinitionEditor.CanReorderListItems, Mode=OneWay}"
                                      Visibility="{Binding LocalDefinitionEditor.ListReorderAvailable, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                      CommandParameter="{Binding SelectedItem, ElementName=LocalDefinitionList}" />
                              <Button Content="Move down" Click="MoveLocalDefinitionListItemDown_Click"
                                      IsEnabled="{Binding LocalDefinitionEditor.CanReorderListItems, Mode=OneWay}"
                                      Visibility="{Binding LocalDefinitionEditor.ListReorderAvailable, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                      CommandParameter="{Binding SelectedItem, ElementName=LocalDefinitionList}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding LocalDefinitionEditor.ListConstraintDisplay, Mode=OneWay}"
                                       Foreground="#93A4BB" FontSize="10" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Text="{Binding LocalDefinitionEditor.HelpText, Mode=OneWay}"
                                     Foreground="#93A4BB" FontSize="10"
                                     TextWrapping="Wrap" Margin="0,4,0,0" />
                          <Button Content="Save as preset..."
                                  Click="SaveModulePreset_Click"
                                  IsEnabled="{Binding CanSaveModulePreset, Mode=OneWay}"
                                  Visibility="{Binding ModulePresetManagementVisible, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                  HorizontalAlignment="Left" Margin="0,7,0,0"
                                  AutomationProperties.Name="Save profile-local Modules as preset" />
                        </StackPanel>
                      </StackPanel>
                      <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{Binding ValueEditorEnabled, Mode=OneWay}"
                               Visibility="{Binding UsesTextEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                      <CheckBox Content="Enabled" IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                IsEnabled="{Binding BooleanControlEnabled, Mode=OneWay}"
                                Visibility="{Binding UsesBooleanEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />

                      <ItemsControl ItemsSource="{Binding ChoiceFields, Mode=OneWay}"
                                    IsEnabled="{Binding ValueEditorEnabled, Mode=OneWay}"
                                    Visibility="{Binding UsesKeyedChoiceEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,4">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                         VerticalAlignment="Center" />
                              <ComboBox Grid.Column="1"
                                        ItemsSource="{Binding Options, Mode=OneWay}"
                                        DisplayMemberPath="DisplayName"
                                        SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                        IsEnabled="{Binding SelectionEnabled, Mode=OneWay}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <StackPanel IsEnabled="{Binding ValueEditorEnabled, Mode=OneWay}"
                                  Visibility="{Binding UsesListEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <ListBox x:Name="ManagedListValueList" ItemsSource="{Binding ListValues, Mode=OneWay}"
                                 DisplayMemberPath="DisplayName" Height="84" />
                        <ComboBox ItemsSource="{Binding AvailableListOptions, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedListOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" Margin="0,4,0,2"
                                  Visibility="{Binding ListMembershipEditable, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                        <WrapPanel>
                          <Button Content="Add" Click="AddListItem_Click"
                                  IsEnabled="{Binding CanAddListItem, Mode=OneWay}"
                                  Visibility="{Binding ListMembershipEditable, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                          <Button Content="Remove" Click="RemoveListItem_Click"
                                  IsEnabled="{Binding CanRemoveListItem, Mode=OneWay}"
                                  Visibility="{Binding ListMembershipEditable, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                  CommandParameter="{Binding SelectedItem, ElementName=ManagedListValueList}" />
                          <Button Content="Move up" Click="MoveListItemUp_Click"
                                  IsEnabled="{Binding CanReorderListItems, Mode=OneWay}"
                                  Visibility="{Binding ListReorderAvailable, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                  CommandParameter="{Binding SelectedItem, ElementName=ManagedListValueList}" />
                          <Button Content="Move down" Click="MoveListItemDown_Click"
                                  IsEnabled="{Binding CanReorderListItems, Mode=OneWay}"
                                  Visibility="{Binding ListReorderAvailable, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                  CommandParameter="{Binding SelectedItem, ElementName=ManagedListValueList}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ListConstraintDisplay, Mode=OneWay}"
                                   Foreground="#93A4BB" FontSize="10" TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel IsEnabled="{Binding ValueEditorEnabled, Mode=OneWay}"
                                  Visibility="{Binding UsesUltimateWeaponEditor, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl ItemsSource="{Binding UltimateGroups, Mode=OneWay}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="#263349" BorderThickness="1" CornerRadius="4"
                                      Padding="6" Margin="0,0,0,5">
                                <StackPanel>
                                  <CheckBox Content="{Binding DisplayName, Mode=OneWay}"
                                            IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                            IsEnabled="{Binding InclusionEnabled, Mode=OneWay}"
                                            FontWeight="SemiBold" />
                                  <ItemsControl ItemsSource="{Binding Fields, Mode=OneWay}" Margin="18,3,0,0">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                          </Grid.ColumnDefinitions>
                                          <CheckBox Content="{Binding DisplayName, Mode=OneWay}"
                                                    IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                    IsEnabled="{Binding InclusionEnabled, Mode=OneWay}" />
                                          <ComboBox Grid.Column="1"
                                                    ItemsSource="{Binding Options, Mode=OneWay}"
                                                    DisplayMemberPath="DisplayName"
                                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                    IsEnabled="{Binding SelectionEnabled, Mode=OneWay}" />
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <TextBlock Text="{Binding UnknownRetainedDisplay, Mode=OneWay}"
                                             Foreground="#93A4BB" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding UnknownRetainedDisplay, Mode=OneWay}"
                                   Foreground="#93A4BB" FontSize="10" TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Visibility="{Binding IsReadOnlyValue, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="This server declared an editor type this client does not recognize. Its retained value is not exposed or modified."
                                   Foreground="#F1BF5B" FontSize="10" TextWrapping="Wrap" />
                      </StackPanel>

                      <TextBlock Text="{Binding ValueEditorExplanation, Mode=OneWay}"
                                 Foreground="#93A4BB" FontSize="10"
                                 TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Border Grid.Row="6" Background="#0D1420" BorderBrush="#263349"
                  BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
            <TextBlock x:Name="ValidationSummaryText"
                       Text="Validate to refresh effective values, provenance, fingerprints, and generated rule count."
                       Foreground="#C8D5E6" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Loading authoring catalog..."
               Foreground="#93A4BB" TextWrapping="Wrap" Margin="2,0,2,10" />

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Bases are never activatable. Publishing a Strategy also leaves the active Strategy unchanged."
                 Foreground="#93A4BB" FontSize="11" VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Grid.Column="1" x:Name="ValidateButton" Content="Validate draft"
              Click="Validate_Click" IsEnabled="False" />
      <Button Grid.Column="2" Content="Close" Click="Close_Click" />
      <Button Grid.Column="3" x:Name="PublishButton" Content="Review &amp; Publish..."
              Click="Publish_Click" Style="{StaticResource PrimaryButton}"
              IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
