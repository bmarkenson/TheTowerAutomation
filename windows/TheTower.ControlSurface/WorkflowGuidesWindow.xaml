<Window x:Class="TheTower.ControlSurface.WorkflowGuidesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Guides"
        Icon="Assets/TheTower.ControlSurface.ico"
        Width="1080" Height="780" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E16" Foreground="#EDF2F7"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Workflow Guides" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="Version-matched, read-only guidance for infrequent operations. Guide buttons navigate to existing guarded controls; they never perform an action."
                 Foreground="{StaticResource MutedBrush}"
                 TextWrapping="Wrap"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Style="{StaticResource DashboardCard}"
              Padding="8">
        <ListBox x:Name="GuideList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#EDF2F7"
                 SelectionChanged="GuideList_SelectionChanged"
                 AutomationProperties.Name="Workflow guide topics">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,5" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="TopicBorder"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="6"
                          Padding="10">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="TopicBorder" Property="Background" Value="#182338" />
                      <Setter TargetName="TopicBorder" Property="BorderBrush" Value="#344660" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="TopicBorder" Property="Background" Value="#0E4E67" />
                      <Setter TargetName="TopicBorder" Property="BorderBrush" Value="#62D5FF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}"
                           Foreground="#B7C5D7"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           MaxHeight="48"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2"
              Style="{StaticResource DashboardCard}"
              Padding="0">
        <Grid x:Name="GuideContentPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Background="#111827"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="18,15">
            <StackPanel>
              <TextBlock Text="{Binding Title}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Summary}"
                         Foreground="#B7C5D7"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="16">
            <StackPanel>
              <ItemsControl x:Name="GuideSections">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,11"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="13">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#151F31" />
                          <Setter Property="BorderBrush" Value="#344660" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="Caution">
                              <Setter Property="Background" Value="#352914" />
                              <Setter Property="BorderBrush" Value="#B9852A" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Success">
                              <Setter Property="Background" Value="#12372E" />
                              <Setter Property="BorderBrush" Value="#318767" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock Text="{Binding Heading}"
                                   Foreground="#62D5FF"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Introduction}"
                                   Foreground="#DCE5F0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0" />
                        <ItemsControl ItemsSource="{Binding Items}"
                                      Margin="0,4,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="34" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Marker}"
                                           Foreground="#62D5FF"
                                           FontWeight="Bold"
                                           TextAlignment="Right"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           Foreground="#DCE5F0"
                                           TextWrapping="Wrap"
                                           LineHeight="20" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1,0,0,0"
                      Padding="10,2,0,2"
                      Margin="0,2,0,4">
                <StackPanel>
                  <TextBlock Text="DETAILED REPOSITORY OWNER"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="9"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding CanonicalSource}"
                             Foreground="#B7C5D7"
                             FontSize="10"
                             TextWrapping="Wrap"
                             Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="These guides describe the controls packaged in this client build."
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="10"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Grid.Column="1"
              x:Name="NavigateButton"
              Content="{Binding DataContext.NavigationLabel, ElementName=GuideContentPanel}"
              Click="Navigate_Click"
              Style="{StaticResource PrimaryButton}"
              MinWidth="170" />
      <Button Grid.Column="2"
              Content="Close"
              Click="Close_Click"
              MinWidth="90" />
    </Grid>
  </Grid>
</Window>
