<Window x:Class="TheTower.ControlSurface.GateDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup gate needs direction"
        Width="620" Height="520" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E16" Foreground="#EDF2F7"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText"
               Text="A startup requirement could not be satisfied"
               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <Border Grid.Row="1" Background="#111827" BorderBrush="#263349"
            BorderThickness="1" CornerRadius="8" Padding="12">
      <StackPanel>
        <TextBlock x:Name="CheckText" FontWeight="SemiBold" />
        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,7,0,0" />
        <TextBlock x:Name="ExpectedText" TextWrapping="Wrap" Foreground="#93A4BB"
                   Margin="0,7,0,0" />
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" Text="Choose how this run should proceed:"
               Foreground="#93A4BB" Margin="0,14,0,8" />
    <ListBox Grid.Row="3" x:Name="OptionsList" Background="#111827"
             BorderBrush="#263349" Foreground="#EDF2F7" Padding="4">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="8,7">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}" Foreground="#93A4BB"
                       FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="DispositionText"
                 Text="Closing leaves automation blocked at this gate."
                 Foreground="#93A4BB" FontSize="11" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Decide later" Click="Later_Click" />
      <Button Grid.Column="2" Content="Apply choice" Click="Apply_Click"
              Style="{StaticResource PrimaryButton}" />
    </Grid>
  </Grid>
</Window>
