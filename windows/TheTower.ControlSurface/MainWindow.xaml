<Window x:Class="TheTower.ControlSurface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TheTower Control Surface"
        Icon="Assets/TheTower.ControlSurface.ico"
        Width="1500" Height="940" MinWidth="1120" MinHeight="720"
        Background="#0A0E16" Foreground="#EDF2F7">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,24,0">
          <TextBlock Text="THETOWER" FontSize="18" FontWeight="Bold" Foreground="#62D5FF" />
          <TextBlock Text="Native control surface" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="ConnectionText" Text="Not connected" VerticalAlignment="Center" Foreground="#F1BF5B" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="API" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8" />
        <TextBox Grid.Column="3" x:Name="BaseUrlBox" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="Token" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8" />
        <PasswordBox Grid.Column="5" x:Name="TokenBox" VerticalAlignment="Center" />
        <Button Grid.Column="6" Content="Connect" Style="{StaticResource PrimaryButton}" Click="Connect_Click" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <UniformGrid Columns="8">
          <StackPanel><TextBlock Text="DIRECTIVE" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="DirectiveText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
          <StackPanel><TextBlock Text="OBSERVED UI" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="ObservedStateText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
          <StackPanel><TextBlock Text="WAVE" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="WaveText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
          <StackPanel><TextBlock Text="COINS / MIN" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="CoinsMinuteText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
          <StackPanel><TextBlock Text="MODE" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="ModeText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
          <StackPanel><TextBlock Text="SERVICE" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="ServiceText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
          <StackPanel><TextBlock Text="PROCESS PID" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="ProcessPidText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
          <StackPanel><TextBlock Text="HEARTBEAT" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="HeartbeatText" Text="-" FontSize="17" FontWeight="Bold" /></StackPanel>
        </UniformGrid>
        <TextBlock x:Name="PriorTransitionText"
                   Text="PRIOR TRANSITION  —"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="10"
                   Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="260" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="600" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="1.25*" MinHeight="130" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" MinHeight="115" />
          <RowDefinition Height="8" />
          <RowDefinition Height="1.05*" MinHeight="125" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" MinHeight="100" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="SSH TUNNEL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" />
              <TextBlock Text="Linux destination (host, alias, or user@host)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,5,4,2" />
              <TextBox x:Name="SshDestinationBox" TextChanged="SshDestinationBox_TextChanged" />
              <UniformGrid Columns="2" Margin="0,5,0,0">
                <StackPanel Margin="4">
                  <TextBlock Text="Local port" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBox x:Name="LocalTunnelPortBox" />
                </StackPanel>
                <StackPanel Margin="4">
                  <TextBlock Text="Remote API port" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBox x:Name="RemoteApiPortBox" />
                </StackPanel>
              </UniformGrid>
              <UniformGrid Columns="2">
                <Button x:Name="StartTunnelButton" Content="Start tunnel" Click="StartTunnel_Click" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="StopTunnelButton" Content="Stop tunnel" Click="StopTunnel_Click" IsEnabled="False" />
              </UniformGrid>
              <TextBlock x:Name="TunnelStatusText" Text="Stopped" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,5,6,2" />
              <TextBlock x:Name="LinuxServiceCompatibilityText" Text="Waiting for Linux API compatibility status." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,3,6,0" />
              <Button x:Name="RestartControlSurfaceButton" Content="Restart Linux API service" Click="RestartControlSurface_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Visibility="Collapsed" Margin="4,3,4,2" />
              <TextBlock Text="Destination and ports are saved after a successful start. The tunnel does not auto-start." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,2" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Style="{StaticResource PanelSplitter}" />

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="AUTOMATION CONTROL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" />
              <UniformGrid Columns="2">
                <Button x:Name="PauseButton" Content="Paused" Tag="pause" Click="Control_Click" />
                <Button x:Name="ResumeButton" Content="Running" Tag="resume" Click="Control_Click" />
                <Button Content="Pause 15 min" Tag="pause:15" Click="Control_Click" />
                <Button Content="Pause 30 min" Tag="pause:30" Click="Control_Click" />
              </UniformGrid>
              <Button x:Name="GateDecisionButton" Content="Review preflight decision" Click="GateDecision_Click" Style="{StaticResource DangerButton}" IsEnabled="False" Margin="4,8,4,2" />
              <TextBlock x:Name="GateDecisionText" Text="No preflight decision is waiting for direction." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,0,6,4" />
              <TextBlock Text="GAME OVER MODE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,10,4,0" />
              <UniformGrid Columns="3">
                <Button x:Name="RetryModeButton" Content="Retry" Tag="RETRY" Click="Mode_Click" />
                <Button x:Name="WaitModeButton" Content="Wait" Tag="WAIT" Click="Mode_Click" />
                <Button x:Name="HomeModeButton" Content="Home" Tag="HOME" Click="Mode_Click" />
              </UniformGrid>
              <TextBlock Text="STRATEGY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,10,4,0" />
              <ComboBox x:Name="StrategySelectionBox" SelectionChanged="StrategySelectionBox_SelectionChanged" IsEnabled="False" Margin="4">
                <ComboBoxItem Content="Farm T18" Tag="farm_t18" />
                <ComboBoxItem Content="Farm T19" Tag="farm_t19" />
                <ComboBoxItem Content="Tournament" Tag="tournament" />
                <ComboBoxItem Content="No strategy" Tag="none" />
              </ComboBox>
              <UniformGrid Columns="2">
                <Button x:Name="QueueStrategyButton" Content="Queue for next boundary" Click="QueueStrategy_Click" IsEnabled="False" />
                <Button x:Name="AdoptStrategyButton" Content="Adopt for active battle" Click="AdoptStrategy_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" />
              </UniformGrid>
              <TextBlock x:Name="StrategySelectionText" Text="Waiting for strategy status." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,4,6,0" />
              <TextBlock x:Name="TournamentValidationText" Text="No exclusive strategy validation request." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,2,6,0" />
              <Button x:Name="TournamentLaunchButton" Content="Review Tournament launch" Click="TournamentLaunch_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="4,4,4,2" />
              <TextBlock Text="Select a strategy, then choose its disposition. Queue preserves the current battle strategy; selecting Current and queueing cancels a different pending request. Adopt changes behavior and Battle End identity after fresh active-battle evidence; new-run gates wait for the next genuine boundary unless the observer declares a read-only attachment check." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,2,6,4" />
              <Button x:Name="ConfigureRunButton" Content="Configure run..." Click="ConfigureRun_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="4,4,4,2" />
              <TextBlock x:Name="ConfigureRunText" Text="Strategy defaults; no one-run skips staged." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,0,6,4" />
              <TextBlock x:Name="ControlSelectionText" Text="Waiting for control status." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,4" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Style="{StaticResource PanelSplitter}" />

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="PROCESS LIFECYCLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" />
              <Grid Margin="4,4,4,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ADB port" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="AdbPortBox" MinWidth="70" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="SetAdbPortButton" Content="Save" Click="SetAdbPort_Click" IsEnabled="False" />
              </Grid>
              <TextBlock x:Name="AdbPortHelpText" Text="Pause automation before switching a live ADB port." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,0,6,8" />
              <CheckBox x:Name="AttachCurrentBattleBox" Content="Attach to current battle; run gates next battle" Click="StartupGatePolicy_Click" Margin="6,4,6,2" IsEnabled="False" />
              <TextBlock Text="Use this when automation is starting in an existing battle. Normal automation continues, but startup and session gates wait for the next run boundary unless the observer declares a read-only attachment check." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="24,0,6,8" />
              <Button x:Name="StartPausedButton" Content="Start paused" Tag="start:PAUSED" Click="Process_Click" IsEnabled="False" />
              <Button x:Name="StartRunningButton" Content="Start running" Tag="start:RUNNING" Click="Process_Click" Style="{StaticResource SuccessButton}" IsEnabled="False" />
              <TextBlock Text="Start applies the strategy currently selected above before launching automation. Leave attachment unchecked on no-battle Home so that strategy startup gates run immediately." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,0,6,4" />
              <Button x:Name="ReloadAutomationButton" Content="Reload automation for current battle" Click="ReloadAutomation_Click" Style="{StaticResource PrimaryButton}" Margin="4,12,4,2" IsEnabled="False" />
              <TextBlock Text="Safely pauses and replaces the main Python process, attaches the replacement to the current battle, verifies readiness, and restores the prior control state." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,0,6,4" />
              <Button x:Name="CompleteStopButton" Content="Completely stop automation" Tag="stop" Click="Process_Click" Style="{StaticResource DangerButton}" Margin="4,12,4,4" IsEnabled="False" />
              <TextBlock Text="Stop persists STOPPED before stopping the fixed Linux systemd service." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="6" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <GridSplitter Grid.Row="5" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Style="{StaticResource PanelSplitter}" />

        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="RUNTIME EVIDENCE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" />
              <TextBlock x:Name="RuntimeDetailText" Text="No runtime evidence." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,8" />
              <TextBlock x:Name="LastErrorText" Text="" TextWrapping="Wrap" Foreground="#FFACB9" Margin="4" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" Style="{StaticResource PanelSplitter}" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="205" MinHeight="155" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="MOST RECENT COMPLETED BATTLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Open battle history..." Click="OpenBattleHistory_Click" Style="{StaticResource PrimaryButton}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="4,5,4,12">
              <TextBlock x:Name="LatestBattleTitleText" Text="No completed battles found" FontSize="17" FontWeight="Bold" />
              <TextBlock Foreground="{StaticResource MutedBrush}">
                <Run Text="Captured: " /><Run x:Name="LatestCapturedText" Text="-" />
                <Run Text="   Strategy: " /><Run x:Name="LatestStrategyText" Text="-" />
              </TextBlock>
            </StackPanel>
            <UniformGrid Grid.Row="2" Columns="9">
              <StackPanel><TextBlock Text="TYPE" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestTypeText" Text="-" FontWeight="Bold" Foreground="#F1BF5B" /></StackPanel>
              <StackPanel><TextBlock Text="TIER" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestTierText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="WAVE" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestWaveText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="REAL TIME" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestTimeText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="COINS" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCoinsText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="COINS / HOUR" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCoinsHourText" Text="-" FontWeight="Bold" Foreground="#62D5FF" /></StackPanel>
              <StackPanel><TextBlock Text="CELLS" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCellsText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="CELLS / HOUR" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCellsHourText" Text="-" FontWeight="Bold" Foreground="#49D69D" /></StackPanel>
              <StackPanel><TextBlock Text="QUALITY" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestQualityText" Text="-" FontWeight="Bold" /></StackPanel>
            </UniformGrid>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Style="{StaticResource PanelSplitter}" />

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="RECENT ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="ActivityStatusText" Text="Not updated" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0" />
              <Button Grid.Column="2" x:Name="CopyActivityButton" Content="Copy selected" Click="CopyActivity_Click" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" />
              <Button Grid.Column="3" Content="Refresh now" Click="RefreshActivity_Click" Padding="10,5" />
            </Grid>
            <WrapPanel Grid.Row="1" Margin="4,0,4,6" VerticalAlignment="Center">
              <TextBlock Text="Show" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="ActivityLevelFilter" Width="220" SelectedIndex="0">
                <ComboBoxItem Content="Operational" Tag="ACTION,RESULT,WARN,ERROR,FAIL" />
                <ComboBoxItem Content="All levels" Tag="" />
                <ComboBoxItem Content="Warnings and errors" Tag="WARN,ERROR,FAIL" />
                <ComboBoxItem Content="Errors and failures" Tag="ERROR,FAIL" />
                <ComboBoxItem Content="Diagnostics" Tag="INPUT,DEBUG,MATCH,STATE" />
                <ComboBoxItem Content="Status only" Tag="STATUS" />
                <ComboBoxItem Content="Actions only" Tag="ACTION" />
                <ComboBoxItem Content="Results only" Tag="RESULT" />
                <ComboBoxItem Content="Inputs only" Tag="INPUT" />
                <ComboBoxItem Content="Info only" Tag="INFO" />
                <ComboBoxItem Content="Warnings only" Tag="WARN" />
                <ComboBoxItem Content="Errors only" Tag="ERROR" />
                <ComboBoxItem Content="Debug only" Tag="DEBUG" />
                <ComboBoxItem Content="Matches only" Tag="MATCH" />
                <ComboBoxItem Content="State only" Tag="STATE" />
                <ComboBoxItem Content="Failures only" Tag="FAIL" />
              </ComboBox>
              <CheckBox x:Name="ActivityAutoFollowBox" Content="Follow newest" IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" />
              <TextBlock Text="Double-click a row to show the full line"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         VerticalAlignment="Center"
                         Margin="14,0,0,0" />
            </WrapPanel>
            <DataGrid Grid.Row="2" x:Name="ActivityGrid"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="ExcludeHeader"
                      AreRowDetailsFrozen="True"
                      RowDetailsVisibilityMode="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="ActivityGrid_SelectionChanged"
                      MouseDoubleClick="ActivityGrid_MouseDoubleClick"
                      PreviewKeyDown="ActivityGrid_PreviewKeyDown">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy selected" Click="CopyActivity_Click" InputGestureText="Ctrl+C" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource PanelAltBrush}"
                          BorderBrush="{StaticResource AccentBrush}"
                          BorderThickness="3,0,0,0"
                          Padding="12,9"
                          Margin="0,0,0,3">
                    <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <TextBlock TextWrapping="Wrap">
                        <Run Text="[" /><Run Text="{Binding Level}" /><Run Text=" " /><Run Text="{Binding Timestamp}" /><Run Text="] " /><Run Text="{Binding Message}" />
                      </TextBlock>
                    </ScrollViewer>
                  </Border>
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="155" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
