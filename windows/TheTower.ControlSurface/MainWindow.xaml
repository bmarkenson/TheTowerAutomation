<Window x:Class="TheTower.ControlSurface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TheTower Control Surface"
        Icon="Assets/TheTower.ControlSurface.ico"
        Width="1500" Height="940" MinWidth="1120" MinHeight="720"
        Background="#0A0E16" Foreground="#EDF2F7">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,24,0">
          <TextBlock Text="THETOWER" FontSize="18" FontWeight="Bold" Foreground="#62D5FF" />
          <TextBlock Text="Native control surface" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="82" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="82" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="LINUX API" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="LinuxApiServiceStatusText" Text="Unknown" Margin="6,0,14,0" Foreground="#F1BF5B" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="HTTP" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" x:Name="ConnectionText" Text="Not connected" Margin="6,0,0,0" Foreground="#F1BF5B" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Text="API SSH" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ApiTunnelTopStatusText" Text="Stopped" Margin="6,0,14,0" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="ADB SSH" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="3" x:Name="AdbTunnelTopStatusText" Text="Stopped" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Button Grid.Column="2"
                x:Name="ToggleControlSurfaceServiceButton"
                Content="Start API"
                Click="ToggleControlSurfaceService_Click"
                Padding="8,6"
                Margin="2"
                FontSize="10"
                IsEnabled="False"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="Start or stop only the fixed Linux control API service." />
        <Button Grid.Column="3"
                x:Name="RestartControlSurfaceTopButton"
                Content="Restart API service"
                Click="RestartControlSurface_Click"
                Padding="8,6"
                Margin="2"
                FontSize="10"
                IsEnabled="False"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="Restart only the fixed Linux control API service; automation is unchanged." />
        <Button Grid.Column="4"
                x:Name="RestartSshButton"
                Content="Restart SSH…"
                Click="RestartSshMenu_Click"
                Padding="8,6"
                Margin="2"
                FontSize="10"
                ToolTip="Restart the API or ADB SSH tunnel independently.">
          <Button.ContextMenu>
            <ContextMenu x:Name="RestartSshMenu">
              <MenuItem x:Name="RestartApiTunnelMenuItem"
                        Header="Restart API tunnel"
                        Click="RestartApiTunnel_Click" />
              <MenuItem x:Name="RestartAdbTunnelMenuItem"
                        Header="Restart ADB tunnel"
                        Click="RestartAdbTunnel_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button Grid.Column="5"
                Content="Controls"
                Click="ShowControls_Click"
                Padding="8,6"
                Margin="2"
                FontSize="10"
                ToolTip="Open the everyday automation controls." />
        <Button Grid.Column="6"
                Content="Connection setup"
                Click="ShowSetup_Click"
                Padding="8,6"
                Margin="2"
                FontSize="10"
                ToolTip="Open API and SSH tunnel settings." />
        <Button Grid.Column="7"
                Content="Reset layout"
                Click="ResetLayout_Click"
                Padding="8,6"
                Margin="2"
                FontSize="10"
                ToolTip="Restore the default pane sizes and expanded sections." />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            x:Name="CompatibilityBanner"
            Visibility="Collapsed"
            Background="#352914"
            BorderBrush="#F1BF5B"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,18,0">
          <TextBlock x:Name="CompatibilityBannerTitle"
                     Text="LINUX API UPDATE REQUIRED — AUTOMATION START IS DISABLED"
                     Foreground="#FFD37A"
                     FontSize="12"
                     FontWeight="Bold" />
          <TextBlock x:Name="CompatibilityBannerText"
                     Text="Restart the Linux API service, then retry Start."
                     Foreground="#F7E8C1"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1"
                x:Name="RestartControlSurfaceBannerButton"
                Content="Restart Linux API service"
                Click="RestartControlSurface_Click"
                Style="{StaticResource PrimaryButton}"
                MinWidth="210"
                VerticalAlignment="Center"
                IsEnabled="False"
                ToolTipService.ShowOnDisabled="True" />
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource PanelAltBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="0,0,0,10">
      <StackPanel>
        <Grid Margin="0,0,0,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="CURRENT STATUS"
                     Foreground="#62D5FF"
                     FontSize="10"
                     FontWeight="Bold"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  x:Name="PreviousStateToggleButton"
                  Content="Hide previous state"
                  Click="PreviousStateToggle_Click"
                  Padding="9,4"
                  FontSize="10" />
          <Button Grid.Column="2"
                  x:Name="HostHealthToggleButton"
                  Content="Show host health"
                  Click="HostHealthToggle_Click"
                  Padding="9,4"
                  FontSize="10" />
        </Grid>
        <Border x:Name="StrategyActionGateBanner"
                Visibility="Collapsed"
                Background="#302515"
                BorderBrush="#F1BF5B"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10,8"
                Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Strategy actions blocked — observation and safe collectors remain active."
                       Foreground="#FFD37A"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StrategyActionGateReasonText"
                       Text="-"
                       Foreground="#F7E8C1"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
            <TextBlock x:Name="StrategyActionGateChecksText"
                       Text="Failed checks: -"
                       Foreground="#C8D5E6"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0" />
            <TextBlock x:Name="StrategyActionGateCollectorsText"
                       Text="Allowed collectors: -"
                       Foreground="#C8D5E6"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <UniformGrid Columns="7">
          <StackPanel ToolTip="The requested automation control state. The controls pane shows whether the live runtime has acknowledged it.">
            <TextBlock Text="AUTOMATION" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <TextBlock x:Name="DirectiveText" Text="-" FontSize="17" FontWeight="Bold" />
          </StackPanel>
          <StackPanel ToolTip="The game screen most recently identified by the observer.">
            <TextBlock Text="GAME SCREEN" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <TextBlock x:Name="ObservedStateText" Text="-" FontSize="17" FontWeight="Bold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="WAVE" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <TextBlock x:Name="WaveText" Text="-" FontSize="17" FontWeight="Bold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="COINS / MIN" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <TextBlock x:Name="CoinsMinuteText" Text="-" FontSize="17" FontWeight="Bold" />
          </StackPanel>
          <StackPanel ToolTip="Speed read directly from the latest periodic game screenshot.">
            <TextBlock Text="OBSERVED SPEED" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <TextBlock x:Name="ObservedSpeedText" Text="-" FontSize="17" FontWeight="Bold" />
          </StackPanel>
          <StackPanel ToolTip="What automation should do when the current battle ends.">
            <TextBlock Text="WHEN THIS BATTLE ENDS" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <TextBlock x:Name="ModeText" Text="-" FontSize="17" FontWeight="Bold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="HEARTBEAT" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <TextBlock x:Name="HeartbeatText" Text="-" FontSize="17" FontWeight="Bold" />
          </StackPanel>
        </UniformGrid>
        <Border x:Name="PreviousStatePanel"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="9,6"
                Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PREVIOUS GAME SCREEN"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,0,12,0" />
            <TextBlock Grid.Column="1"
                       x:Name="PriorTransitionText"
                       Text="—"
                       Foreground="#C8D5E6"
                       FontSize="10"
                       FontWeight="SemiBold" />
          </Grid>
        </Border>
        <Border x:Name="HostPerformancePanel"
                Visibility="Collapsed"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="9,7"
                Margin="0,4,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="0.8*" />
              <ColumnDefinition Width="1.2*" />
              <ColumnDefinition Width="1.0*" />
              <ColumnDefinition Width="1.25*" />
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="0.9*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Text="HOST HEALTH" Foreground="{StaticResource MutedBrush}" FontSize="9" />
              <TextBlock x:Name="HostHealthText" Text="Starting" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
              <TextBlock Text="HOST CPU" Foreground="{StaticResource MutedBrush}" FontSize="9" />
              <TextBlock x:Name="HostCpuText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
              <TextBlock Text="MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="9" />
              <TextBlock x:Name="HostMemoryText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
              <TextBlock Text="CPU CLOCK" Foreground="{StaticResource MutedBrush}" FontSize="9" />
              <TextBlock x:Name="HostClockText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,8,0">
              <TextBlock Text="BLUESTACKS CPU" Foreground="{StaticResource MutedBrush}" FontSize="9" />
              <TextBlock x:Name="BlueStacksCpuText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="5" Margin="0,0,8,0">
              <TextBlock Text="BLUESTACKS RAM" Foreground="{StaticResource MutedBrush}" FontSize="9" />
              <TextBlock x:Name="BlueStacksMemoryText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="6" Margin="0,0,8,0">
              <TextBlock Text="TELEMETRY" Foreground="{StaticResource MutedBrush}" FontSize="9" />
              <TextBlock x:Name="HostTelemetryQueueText" Text="Local only" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="7"
                    x:Name="HostSamplingToggleButton"
                    Content="Pause sampling"
                    Click="HostSamplingToggle_Click"
                    Padding="9,5"
                    Margin="4,0,0,0"
                    MinWidth="104"
                    VerticalAlignment="Center"
                    ToolTip="Pause one-second host and BlueStacks sampling. Queued aggregates continue uploading." />
            <Grid Grid.Row="1" Grid.ColumnSpan="8" Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.65*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="HOST GPU" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                <TextBlock x:Name="HostGpuText" Text="Starting" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="GPU MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                <TextBlock x:Name="HostGpuMemoryText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="BLUESTACKS GPU" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                <TextBlock x:Name="BlueStacksGpuText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="TOP OTHER GPU PROCESS" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                <TextBlock x:Name="GpuCompetitorText" Text="-" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="380" MinWidth="320" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="600" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="6">
        <TabControl x:Name="SidebarTabs"
                    Background="{StaticResource PanelBrush}"
                    BorderThickness="0">
          <TabItem Header="Controls">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="7">
                <TextBlock Text="AUTOMATION"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="4" />
                <UniformGrid Columns="2">
                  <Button x:Name="PauseButton" Content="Automation Paused" Tag="pause" Click="Control_Click" />
                  <Button x:Name="ResumeButton" Content="Automation Enabled" Tag="enable" Click="Control_Click" />
                  <Button x:Name="Pause15Button" Content="Pause 15 min" Tag="pause:15" Click="Control_Click" />
                  <Button x:Name="Pause30Button" Content="Pause 30 min" Tag="pause:30" Click="Control_Click" />
                </UniformGrid>
                <TextBlock Text="Paused means zero automated device input; observation can continue. Enabled permits guarded actions and does not assert the game is Running."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,6" />
                <UniformGrid Columns="2">
                  <Button x:Name="TakeManualControlButton" Content="Take Manual Control" Tag="take_manual_control" Click="Control_Click" />
                  <Button x:Name="ReturnControlButton" Content="Return Control" Tag="return_control" Click="Control_Click" />
                </UniformGrid>
                <TextBlock x:Name="ManualControlText"
                           Text="Automation retains control."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,4" />
                <TextBlock Text="IF THIS MANUAL BATTLE IS SURRENDERED" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,4,4,0" />
                <ComboBox x:Name="ManualSurrenderCollectionBox" Margin="4" ToolTip="This collection choice never authorizes automation to Surrender.">
                  <ComboBoxItem Content="Exclude stats (minimal save-backed record)" Tag="minimal" IsSelected="True" />
                  <ComboBoxItem Content="Collect normal terminal stats" Tag="full" />
                </ComboBox>
                <TextBlock Text="GAME SPEED" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,10,4,0" />
                <ComboBox x:Name="GameSpeedTargetBox"
                          SelectionChanged="GameSpeedTargetBox_SelectionChanged"
                          Margin="4">
                  <ComboBoxItem Content="x0.0" Tag="0.0" />
                  <ComboBoxItem Content="x0.5" Tag="0.5" />
                  <ComboBoxItem Content="x1.0" Tag="1.0" />
                  <ComboBoxItem Content="x1.5" Tag="1.5" />
                  <ComboBoxItem Content="x2.0" Tag="2.0" />
                  <ComboBoxItem Content="x2.5" Tag="2.5" />
                  <ComboBoxItem Content="x3.0" Tag="3.0" />
                  <ComboBoxItem Content="x3.5" Tag="3.5" />
                  <ComboBoxItem Content="x4.0" Tag="4.0" />
                  <ComboBoxItem Content="x4.5" Tag="4.5" />
                  <ComboBoxItem Content="x5.0" Tag="5.0" />
                  <ComboBoxItem Content="x5.5" Tag="5.5" />
                  <ComboBoxItem Content="x6.0" Tag="6.0" />
                  <ComboBoxItem Content="x6.3 — Maximum available" Tag="6.3" />
                </ComboBox>
                <TextBlock x:Name="GameSpeedTargetText"
                           Text="Maximum available speed is active."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,4" />
                <Button x:Name="GateDecisionButton"
                        Content="Review preflight decision"
                        Click="GateDecision_Click"
                        Style="{StaticResource DangerButton}"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Margin="4,8,4,2" />
                <TextBlock x:Name="GateDecisionText"
                           Text="No preflight decision is waiting for direction."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Visibility="Collapsed"
                           Margin="6,0,6,4" />
                <TextBlock Text="WHEN THIS BATTLE ENDS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,10,4,0" />
                <UniformGrid Columns="3">
                  <Button x:Name="NextBattleModeButton"
                          Content="Continue automatically"
                          Tag="NEXT_BATTLE"
                          ToolTip="Future terminal policy; this is not an immediate battle action."
                          Click="Mode_Click" />
                  <Button x:Name="WaitModeButton" Content="Wait" Tag="WAIT" Click="Mode_Click" />
                  <Button x:Name="HomeModeButton"
                          Content="Return / stay Home"
                          Tag="HOME"
                          ToolTip="Return Home after Game Over and do not automatically start or resume a battle."
                          Click="Mode_Click" />
                </UniformGrid>
                <TextBlock Text="This policy applies after the current battle ends."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,4" />
                <TextBlock Text="BATTLE WORKFLOW" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,10,4,0" />
                <UniformGrid Columns="2">
                  <Button x:Name="StartBattleButton" Content="Start Battle" Tag="start_battle" Click="Control_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True" />
                  <Button x:Name="AttachBattleButton" Content="Attach to Battle" Tag="attach_battle" Click="Control_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True" />
                </UniformGrid>
                <TextBlock x:Name="BattleWorkflowText"
                           Text="Waiting for fresh game-boundary evidence."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,4" />
                <TextBlock Text="SAVE-BACKED AUTHORING" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,10,4,0" />
                <Button x:Name="CaptureSetupButton"
                        Content="Capture current setup as…"
                        Click="CaptureSetup_Click"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True" />
                <TextBlock x:Name="CaptureSetupText"
                           Text="Waiting for an exact runtime-owned boundary."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,4" />
                <TextBlock Text="STRATEGY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,10,4,0" />
                <ComboBox x:Name="StrategySelectionBox"
                          SelectionChanged="StrategySelectionBox_SelectionChanged"
                          IsEnabled="False"
                          Margin="4" />
                <Button x:Name="StrategyProfilesButton"
                        Content="Strategy profiles..."
                        Click="StrategyProfiles_Click"
                        IsEnabled="False"
                        ToolTip="Clone, validate, and publish compact Farm strategy profiles without activating them."
                        Margin="4,2,4,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="QueueStrategyButton" Grid.Column="0" Content="Use next battle" Click="QueueStrategy_Click" IsEnabled="False" />
                  <Button x:Name="AdoptStrategyButton" Grid.Column="1" Content="Switch this battle" Click="AdoptStrategy_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" />
                </Grid>
                <TextBlock x:Name="StrategyActionHelpText"
                           Text="Choose when the selected strategy should take effect."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,0" />
                <TextBlock x:Name="StrategySelectionText"
                           Text="Waiting for strategy status."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,4,6,0" />
                <TextBlock x:Name="TournamentValidationText"
                           Text="No exclusive strategy validation request."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,0" />
                <Button x:Name="TournamentLaunchButton"
                        Content="Review Tournament launch"
                        Click="TournamentLaunch_Click"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Margin="4,4,4,2" />
                <Button x:Name="ConfigureRunButton"
                        Content="Configure next run..."
                        Click="ConfigureRun_Click"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Margin="4,8,4,2" />
                <TextBlock x:Name="ConfigureRunText"
                           Text="Strategy defaults; no one-run skips staged."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,0,6,4" />
                <TextBlock x:Name="ControlSelectionText"
                           Text="Waiting for control status."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,4" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Process">
            <Grid Margin="7">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="4,4,4,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="AUTOMATION SERVICE" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                  <TextBlock x:Name="ServiceText" Text="-" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="PROCESS PID" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                  <TextBlock x:Name="ProcessPidText" Text="-" FontSize="15" FontWeight="Bold" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="4,4,4,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ADB port" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="AdbPortBox" MinWidth="70" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="SetAdbPortButton" Content="Save" Click="SetAdbPort_Click" IsEnabled="False" />
              </Grid>
              <StackPanel Grid.Row="2">
                <TextBlock x:Name="AdbPortHelpText"
                           Text="Pause automation before switching a live ADB port."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,0,6,8" />
                <TextBlock Text="PROCESS LIFECYCLE"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="6,4,6,2" />
                <TextBlock Text="Start Automation launches only the managed process and leaves automated input Paused. Choose Start Battle or Attach to Battle separately on Controls."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="8,2,6,4" />
                <Button x:Name="StartAutomationButton" Content="Start Automation" Tag="start" Click="Process_Click" Style="{StaticResource SuccessButton}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="4,6,4,0" />
              </StackPanel>
              <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Button x:Name="CompleteStopButton"
                        Content="Completely stop automation"
                        Tag="stop"
                        Click="Process_Click"
                        Style="{StaticResource DangerButton}"
                        Margin="4,12,4,4"
                        IsEnabled="False"
                        ToolTip="Persist STOPPED, then stop the fixed Linux automation service." />
              </StackPanel>
              <TextBlock Grid.Row="4"
                         Text="Process lifecycle, action authority, observed game state, strategy scope, and terminal policy are independent. Detailed evidence is on Details."
                         TextWrapping="Wrap"
                         VerticalAlignment="Bottom"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         Margin="6" />
            </Grid>
          </TabItem>

          <TabItem Header="Setup">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="9">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0"
                         Text="API CONNECTION"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         FontWeight="Bold"
                         Margin="4,2,4,5" />
              <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="API URL" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="4" />
                <TextBox Grid.Column="1" x:Name="BaseUrlBox" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1"
                           Text="Token (optional)"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="4"
                           ToolTip="Only for an authenticated API endpoint. The token is held in memory and is never saved." />
                <PasswordBox Grid.Row="1"
                             Grid.Column="1"
                             x:Name="TokenBox"
                             VerticalAlignment="Center"
                             ToolTip="Optional in-memory bearer token; never saved." />
                <Button Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Content="Connect"
                        Style="{StaticResource PrimaryButton}"
                        Click="Connect_Click" />
              </Grid>
              <TextBlock Grid.Row="2"
                         Text="SSH CONNECTION"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         FontWeight="Bold"
                         Margin="4,12,4,5" />
              <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Linux destination (host, alias, or user@host)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,2" />
                <TextBox Grid.Row="1" x:Name="SshDestinationBox" TextChanged="SshDestinationBox_TextChanged" />
                <UniformGrid Grid.Row="2" Columns="2" Margin="0,5,0,0">
                  <StackPanel Margin="4">
                    <TextBlock Text="Local port" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBox x:Name="LocalTunnelPortBox" />
                  </StackPanel>
                  <StackPanel Margin="4">
                    <TextBlock Text="Remote API port" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBox x:Name="RemoteApiPortBox" />
                  </StackPanel>
                </UniformGrid>
              </Grid>
              <StackPanel Grid.Row="4" VerticalAlignment="Top">
                <TextBlock Text="TUNNEL HOST"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="4,8,4,2" />
                <TextBlock x:Name="TunnelHostStatusText"
                           Text="Starting the per-user companion..."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,2" />
                <Button x:Name="RestartTunnelHostButton"
                        Content="Restart tunnel host..."
                        Click="RestartTunnelHost_Click"
                        IsEnabled="False"
                        Margin="4,3,4,2"
                        ToolTip="Explicitly stop the companion and its owned SSH children, then start the packaged host without replaying tunnel desire." />
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="4,10,4,5" />
                <TextBlock Text="API TUNNEL"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="4,8,4,2" />
                <UniformGrid Columns="2">
                  <Button x:Name="StartTunnelButton" Content="Start API tunnel" Click="StartTunnel_Click" Style="{StaticResource PrimaryButton}" />
                  <Button x:Name="StopTunnelButton" Content="Stop API tunnel" Click="StopTunnel_Click" IsEnabled="False" />
                </UniformGrid>
                <TextBlock x:Name="TunnelStatusText" Text="Stopped" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,5,6,2" ToolTipService.ShowDuration="30000" />
                <TextBlock x:Name="LinuxServiceCompatibilityText" Text="Waiting for Linux API compatibility status." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,3,6,0" />
                <Button x:Name="RestartControlSurfaceButton" Content="Restart Linux API service" Click="RestartControlSurface_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Visibility="Collapsed" Margin="4,3,4,2" />
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="4,10,4,5" />
                <TextBlock Text="ADB REVERSE FORWARD"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="4,2,4,2" />
                <UniformGrid Columns="2">
                  <StackPanel Margin="4">
                    <TextBlock Text="Windows BlueStacks ADB port"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11" />
                    <TextBox x:Name="WindowsBlueStacksAdbPortBox"
                             TextChanged="WindowsBlueStacksAdbPortBox_TextChanged"
                             ToolTip="The Windows-local TCP listener exposed by BlueStacks." />
                  </StackPanel>
                  <StackPanel Margin="4">
                    <TextBlock Text="Linux ADB port"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11" />
                    <TextBox x:Name="LinuxAdbForwardPortBox"
                             ToolTip="The per-PC port opened only on Linux loopback." />
                  </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="WindowsAdbListenerStatusText"
                           Text="Windows ADB listener not checked."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="6,2,6,2" />
                <UniformGrid Columns="2">
                  <Button x:Name="StartAdbForwardButton"
                          Content="Start ADB forward"
                          Click="StartAdbForward_Click"
                          Style="{StaticResource PrimaryButton}" />
                  <Button x:Name="StopAdbForwardButton"
                          Content="Stop ADB forward"
                          Click="StopAdbForward_Click"
                          IsEnabled="False" />
                </UniformGrid>
                <TextBlock x:Name="AdbForwardStatusText"
                           Text="Stopped. The API tunnel is independently controlled."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           ToolTipService.ShowDuration="30000"
                           Margin="6,5,6,2" />
              </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Details">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="9">
                <TextBlock Text="RUNTIME EVIDENCE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" />
                <TextBlock x:Name="RuntimeDetailText" Text="No runtime evidence." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,8" />
                <TextBlock x:Name="LastErrorText" Text="" TextWrapping="Wrap" Foreground="#FFACB9" Margin="4" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Cursor="SizeWE"
                    Style="{StaticResource PanelSplitter}" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="LatestBattleRow" Height="205" MinHeight="48" />
          <RowDefinition x:Name="LatestBattleSplitterRow" Height="8" />
          <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition x:Name="LatestBattleTitleRow" Height="Auto" />
              <RowDefinition x:Name="LatestBattleMetricsRow" Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="MOST RECENT COMPLETED BATTLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      x:Name="LatestBattleToggleButton"
                      Content="Hide summary"
                      Click="LatestBattleToggle_Click"
                      Padding="10,5" />
              <Button Grid.Column="2" Content="Open battle history..." Click="OpenBattleHistory_Click" Style="{StaticResource PrimaryButton}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="4,5,4,12">
              <TextBlock x:Name="LatestBattleTitleText" Text="No completed battles found" FontSize="17" FontWeight="Bold" />
              <TextBlock Foreground="{StaticResource MutedBrush}">
                <Run Text="Captured: " /><Run x:Name="LatestCapturedText" Text="-" />
                <Run Text="   Strategy: " /><Run x:Name="LatestStrategyText" Text="-" />
              </TextBlock>
            </StackPanel>
            <UniformGrid Grid.Row="2" Columns="9">
              <StackPanel><TextBlock Text="TYPE" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestTypeText" Text="-" FontWeight="Bold" Foreground="#F1BF5B" /></StackPanel>
              <StackPanel><TextBlock Text="TIER" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestTierText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="WAVE" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestWaveText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="REAL TIME" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestTimeText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="COINS" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCoinsText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="COINS / HOUR" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCoinsHourText" Text="-" FontWeight="Bold" Foreground="#62D5FF" /></StackPanel>
              <StackPanel><TextBlock Text="CELLS" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCellsText" Text="-" FontWeight="Bold" /></StackPanel>
              <StackPanel><TextBlock Text="CELLS / HOUR" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestCellsHourText" Text="-" FontWeight="Bold" Foreground="#49D69D" /></StackPanel>
              <StackPanel><TextBlock Text="QUALITY" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="LatestQualityText" Text="-" FontWeight="Bold" /></StackPanel>
            </UniformGrid>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1"
                      x:Name="LatestBattleSplitter"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      Style="{StaticResource PanelSplitter}" />

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="RECENT ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="ActivityStatusText" Text="Not updated" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0" />
              <Button Grid.Column="2" x:Name="CopyActivityButton" Content="Copy selected" Click="CopyActivity_Click" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" />
              <Button Grid.Column="3" x:Name="ClearActivityButton" Content="Clear view" Click="ClearActivity_Click" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" />
              <Button Grid.Column="4" Content="Refresh now" Click="RefreshActivity_Click" Padding="10,5" />
            </Grid>
            <WrapPanel Grid.Row="1" Margin="4,0,4,6" VerticalAlignment="Center">
              <TextBlock Text="Show" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="ActivityLevelFilter" Width="220" SelectedIndex="0">
                <ComboBoxItem Content="Operational" Tag="ACTION,RESULT,WARN,ERROR,FAIL" />
                <ComboBoxItem Content="All levels" Tag="" />
                <ComboBoxItem Content="Warnings and errors" Tag="WARN,ERROR,FAIL" />
                <ComboBoxItem Content="Errors and failures" Tag="ERROR,FAIL" />
                <ComboBoxItem Content="Diagnostics" Tag="INPUT,DEBUG,MATCH,STATE" />
                <ComboBoxItem Content="Status only" Tag="STATUS" />
                <ComboBoxItem Content="Actions only" Tag="ACTION" />
                <ComboBoxItem Content="Results only" Tag="RESULT" />
                <ComboBoxItem Content="Inputs only" Tag="INPUT" />
                <ComboBoxItem Content="Info only" Tag="INFO" />
                <ComboBoxItem Content="Warnings only" Tag="WARN" />
                <ComboBoxItem Content="Errors only" Tag="ERROR" />
                <ComboBoxItem Content="Debug only" Tag="DEBUG" />
                <ComboBoxItem Content="Matches only" Tag="MATCH" />
                <ComboBoxItem Content="State only" Tag="STATE" />
                <ComboBoxItem Content="Failures only" Tag="FAIL" />
              </ComboBox>
              <TextBlock Text="Scope" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,6,0" />
              <ComboBox x:Name="ActivityScopeFilter" Width="135" SelectedIndex="0">
                <ComboBoxItem Content="Current run" Tag="current_run" />
                <ComboBoxItem Content="All recent" Tag="all" />
              </ComboBox>
              <CheckBox x:Name="ActivityAutoFollowBox" Content="Follow newest" IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" />
              <TextBlock Text="Double-click a row to show full details"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         VerticalAlignment="Center"
                         Margin="14,0,0,0" />
            </WrapPanel>
            <DataGrid Grid.Row="2" x:Name="ActivityGrid"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="ExcludeHeader"
                      AreRowDetailsFrozen="True"
                      RowDetailsVisibilityMode="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="ActivityGrid_SelectionChanged"
                      MouseDoubleClick="ActivityGrid_MouseDoubleClick"
                      PreviewKeyDown="ActivityGrid_PreviewKeyDown">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy selected" Click="CopyActivity_Click" InputGestureText="Ctrl+C" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource PanelAltBrush}"
                          BorderBrush="{StaticResource AccentBrush}"
                          BorderThickness="3,0,0,0"
                          Padding="12,9"
                          Margin="0,0,0,3">
                    <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <TextBlock Text="{Binding ExpandedMessage}"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>
                  </Border>
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="155" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="Message" Binding="{Binding DisplayMessage}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
