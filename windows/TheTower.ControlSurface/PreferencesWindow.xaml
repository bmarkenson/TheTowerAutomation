<Window x:Class="TheTower.ControlSurface.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="700" Height="760" MinWidth="600" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E16" Foreground="#EDF2F7"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Preferences" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Stable connection and presentation defaults. Saving does not start, stop, or restart automation or either SSH tunnel."
                 Foreground="{StaticResource MutedBrush}"
                 TextWrapping="Wrap"
                 Margin="0,5,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,14,0,0">
      <StackPanel>
        <Border Style="{StaticResource DashboardCard}">
          <StackPanel>
            <TextBlock Text="CONTROL API"
                       Foreground="#62D5FF"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="4,0,4,7" />
            <TextBlock Text="API URL" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="4,2" />
            <TextBox x:Name="BaseUrlBox" />
            <TextBlock Text="Bearer token (optional, memory only)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       Margin="4,9,4,2" />
            <PasswordBox x:Name="TokenBox"
                         ToolTip="Used only for the current app process. It is never written to control-surface.json or the tunnel-host configuration." />
            <TextBlock Text="Leave the token blank for the normal loopback SSH route. Saving a new URL or token configures the HTTP client but does not make a request; use Connect now in System to probe it."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="6,5,6,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource DashboardCard}" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="BLUESTACKS RECOVERY"
                       Foreground="#62D5FF"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="4,0,4,7" />
            <CheckBox x:Name="BlueStacksAutomaticRecoveryBox"
                      Content="Allow automatic coordinated BlueStacks restarts"
                      Margin="4,3" />
            <StackPanel Margin="22,2,4,3">
              <CheckBox x:Name="BlueStacksPreventiveHandleRecoveryBox"
                        Content="Preventive restart at the sustained handle ceiling"
                        Margin="4,3" />
              <CheckBox x:Name="BlueStacksInRunPerformanceRecoveryBox"
                        Content="Restart after severe save-backed in-run performance loss"
                        Margin="4,3" />
              <CheckBox x:Name="BlueStacksCompletedRunRecoveryBox"
                        Content="Restart after completed-run degradation confirmation"
                        Margin="4,3" />
              <CheckBox x:Name="BlueStacksDeferDuringExternalContentionBox"
                        Content="Defer preventive restart during external host contention"
                        Margin="4,3" />
            </StackPanel>
            <TextBlock Text="Each detector continues observing while disabled. Severe in-run loss always requires clear host attribution; ambiguous evidence cannot authorize a performance restart."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" TextWrapping="Wrap" Margin="6,3,6,0" />
            <TextBlock Text="HD-Player.exe path"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" Margin="4,8,4,2" />
            <TextBox x:Name="BlueStacksPlayerPathBox" />
            <TextBlock Text="BlueStacks instance name"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" Margin="4,8,4,2" />
            <TextBox x:Name="BlueStacksInstanceNameBox" />
            <TextBlock Text="Recovery is attempted only after Linux has installed a runtime hold. Windows maps this instance to its configured ADB listener, acknowledges one exact executable PID/start time before stop, launches only the immutable target, and requires a new exact listener before Linux relaunches The Tower. Verify the instance name against a BlueStacks-created desktop shortcut before enabling; multiple active instances disable automatic recovery."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" TextWrapping="Wrap" Margin="6,5,6,0" />
            <TextBlock x:Name="BlueStacksRecoveryLockText"
                       Text=""
                       Visibility="Collapsed"
                       Foreground="#F1BF5B"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="6,7,6,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource DashboardCard}" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="SSH AND FORWARDING DEFAULTS"
                       Foreground="#62D5FF"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="4,0,4,7" />
            <TextBlock Text="Linux destination (host, alias, or user@host)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       Margin="4,2" />
            <TextBox x:Name="SshDestinationBox" />
            <UniformGrid Columns="2" Margin="0,6,0,0">
              <StackPanel Margin="4">
                <TextBlock Text="Local API port" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="LocalTunnelPortBox" />
              </StackPanel>
              <StackPanel Margin="4">
                <TextBlock Text="Remote API port" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="RemoteApiPortBox" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Columns="2">
              <StackPanel Margin="4">
                <TextBlock Text="Windows BlueStacks ADB port" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="WindowsBlueStacksAdbPortBox"
                         ToolTip="The Windows-local TCP listener exposed by BlueStacks." />
              </StackPanel>
              <StackPanel Margin="4">
                <TextBlock Text="Linux ADB forward port" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="LinuxAdbForwardPortBox"
                         ToolTip="The per-PC reverse-forward port opened only on Linux loopback." />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="Saved values become the configured defaults for the next tunnel start or explicit restart. A currently running tunnel retains its displayed active endpoint."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="6,4,6,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource DashboardCard}" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="PRESENTATION AND LOCAL SAMPLING"
                       Foreground="#62D5FF"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="4,0,4,7" />
            <CheckBox x:Name="HostPerformanceSamplingBox"
                      Content="Enable host-performance sampling when the app is running"
                      Margin="4,3" />
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="ResetLayoutButton"
                      Content="Reset dashboard layout"
                      Click="ResetLayout_Click" />
              <TextBlock Grid.Column="1"
                         x:Name="ResetLayoutStateText"
                         Text="Keeps this dialog's connection values unchanged."
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Margin="8,0,4,0" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Changes are applied only after Save preferences."
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="11"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="_Cancel" Click="Cancel_Click" />
      <Button Grid.Column="2"
              Content="_Save preferences"
              Click="Save_Click"
              Style="{StaticResource PrimaryButton}" />
    </Grid>
  </Grid>
</Window>
