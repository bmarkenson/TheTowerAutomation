<Window x:Class="TheTower.ControlSurface.BattleHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TheTower.ControlSurface"
        Title="TheTower Completed Battles"
        Icon="Assets/TheTower.ControlSurface.ico"
        Width="1320" Height="860" MinWidth="940" MinHeight="640"
        Background="#0A0E16" Foreground="#EDF2F7">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="360" MinHeight="190" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" MinHeight="230" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="COMPLETED BATTLES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="HistoryStatusText" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,4" />
          <Button Grid.Column="2" x:Name="ExportCsvButton" Content="Export CSV..." Click="ExportCsv_Click" IsEnabled="False" />
          <Button Grid.Column="3" Content="Refresh" Click="Refresh_Click" />
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
          <TextBlock Text="Type" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="4" />
          <ComboBox x:Name="BattleTypeFilter" Width="105" MinHeight="32" SelectedIndex="0"
                    IsTextSearchEnabled="True" AutomationProperties.Name="Battle type"
                    DropDownClosed="BattleFilter_DropDownClosed">
            <ComboBoxItem Content="All" />
            <ComboBoxItem Content="Farm" />
            <ComboBoxItem Content="Tournament" />
            <ComboBoxItem Content="Milestone" />
            <ComboBoxItem Content="Unknown" />
          </ComboBox>
          <TextBlock Text="Tier" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,4,4,4" />
          <TextBox x:Name="TierFilterBox" Width="52" />
          <TextBlock Text="Waves" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,4,4,4" />
          <TextBox x:Name="MinWaveFilterBox" Width="65" ToolTip="Minimum wave" />
          <TextBlock Text="to" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="4" />
          <TextBox x:Name="MaxWaveFilterBox" Width="65" ToolTip="Maximum wave" />
          <TextBlock Text="Strategy" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,4,4,4" />
          <ComboBox x:Name="StrategyFilterBox" Width="180" MinHeight="32"
                    IsTextSearchEnabled="True" AutomationProperties.Name="Strategy"
                    DropDownClosed="BattleFilter_DropDownClosed" />
          <TextBlock Text="Quality" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,4,4,4" />
          <ComboBox x:Name="QualityFilter" Width="85" MinHeight="32" SelectedIndex="0"
                    IsTextSearchEnabled="True" AutomationProperties.Name="Capture quality"
                    DropDownClosed="BattleFilter_DropDownClosed">
            <ComboBoxItem Content="All" />
            <ComboBoxItem Content="Valid" />
            <ComboBoxItem Content="Review" />
          </ComboBox>
          <Button Content="Apply" Click="ApplyBattleFilters_Click" />
          <Button Content="Clear" Click="ClearBattleFilters_Click" />
          <TextBlock x:Name="FilterCountText" Text="" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,4" />
        </WrapPanel>
        <DataGrid Grid.Row="2" x:Name="BattlesGrid" SelectionChanged="BattlesGrid_SelectionChanged" SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Captured" Binding="{Binding CapturedDisplay}" Width="145" />
            <DataGridTextColumn Header="Type" Binding="{Binding BattleTypeDisplay}" Width="95" />
            <DataGridTextColumn Header="Strategy" Binding="{Binding StrategyDisplay}" Width="*" />
            <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="55" />
            <DataGridTextColumn Header="Wave" Binding="{Binding Wave}" Width="70" />
            <DataGridTextColumn Header="Real time" Binding="{Binding RealTime}" Width="85" />
            <DataGridTextColumn Header="Coins/hr" Binding="{Binding CoinsPerHour}" Width="95" />
            <DataGridTextColumn Header="Cells/hr" Binding="{Binding CellsPerHour}" Width="85" />
            <DataGridTextColumn Header="Quality" Binding="{Binding QualityDisplay}" Width="75" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Style="{StaticResource PanelSplitter}" />

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock x:Name="BattleTitleText" Text="Select a completed battle" FontSize="16" FontWeight="Bold" Margin="4,0,4,9" />
          <UniformGrid Columns="9" Margin="0,0,0,8">
            <StackPanel><TextBlock Text="TYPE" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportTypeText" Text="-" FontWeight="Bold" Foreground="#F1BF5B" /></StackPanel>
            <StackPanel><TextBlock Text="TIER" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportTierText" Text="-" FontWeight="Bold" /></StackPanel>
            <StackPanel><TextBlock Text="WAVE" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportWaveText" Text="-" FontWeight="Bold" /></StackPanel>
            <StackPanel><TextBlock Text="REAL TIME" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportTimeText" Text="-" FontWeight="Bold" /></StackPanel>
            <StackPanel><TextBlock Text="COINS" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportCoinsText" Text="-" FontWeight="Bold" /></StackPanel>
            <StackPanel><TextBlock Text="COINS / HOUR" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportCoinsHourText" Text="-" FontWeight="Bold" Foreground="#62D5FF" /></StackPanel>
            <StackPanel><TextBlock Text="CELLS" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportCellsText" Text="-" FontWeight="Bold" /></StackPanel>
            <StackPanel><TextBlock Text="CELLS / HOUR" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportCellsHourText" Text="-" FontWeight="Bold" Foreground="#49D69D" /></StackPanel>
            <StackPanel><TextBlock Text="QUALITY" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBlock x:Name="ReportQualityText" Text="-" FontWeight="Bold" /></StackPanel>
          </UniformGrid>
        </StackPanel>
        <TabControl Grid.Row="1" Background="{StaticResource PanelBrush}">
          <TabItem Header="Battle stats">
            <TreeView x:Name="ReportTree"
                      Background="{StaticResource PanelBrush}"
                      BorderThickness="0"
                      Padding="4"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
              <TreeView.Resources>
                <Style TargetType="{x:Type TreeViewItem}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="IsExpanded" Value="False" />
                </Style>
                <HierarchicalDataTemplate DataType="{x:Type local:ReportSection}"
                                          ItemsSource="{Binding Rows}">
                  <Grid Margin="3,5,8,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Rows.Count, StringFormat={}{0} rows}"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="12,0,0,0" />
                  </Grid>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type local:ReportRow}">
                  <Grid Margin="8,3,8,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               TextWrapping="Wrap"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />
                  </Grid>
                </DataTemplate>
              </TreeView.Resources>
            </TreeView>
          </TabItem>
          <TabItem Header="Selected perks">
            <DataGrid x:Name="PerksGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Latest rank" Binding="{Binding Rank}" Width="90" />
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="90" />
                <DataGridTextColumn Header="Perk" Binding="{Binding Perk}" Width="*" />
                <DataGridTextColumn Header="OCR confidence" Binding="{Binding Confidence}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Settings and evidence">
            <DataGrid x:Name="SettingsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Source" Binding="{Binding Category}" Width="180" />
                <DataGridTextColumn Header="Setting" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="300" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Grid>
</Window>
