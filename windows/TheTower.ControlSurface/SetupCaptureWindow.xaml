<Window x:Class="TheTower.ControlSurface.SetupCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture current setup as…"
        Width="980" Height="760" MinWidth="760" MinHeight="600"
        Background="#0A0E16" Foreground="#EDF2F7"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="SAVE-BACKED AUTHORING" Foreground="#62D5FF" FontSize="10" FontWeight="Bold" />
        <TextBlock Text="Capture current setup as…" FontSize="20" FontWeight="Bold" Margin="0,3,0,4" />
        <TextBlock x:Name="StatusText" Text="Loading the current capture state…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
        <TextBlock x:Name="EvidenceText" Text="-" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <GroupBox Header="Captured values" Grid.Column="0">
        <TextBox x:Name="CapturedValuesText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
      </GroupBox>
      <GroupBox Header="Explicit unresolved values" Grid.Column="2">
        <TextBox x:Name="UnresolvedValuesText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
      </GroupBox>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="0.65*" />
          <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
          <TextBlock Text="KIND" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
          <ComboBox x:Name="KindBox" SelectionChanged="CaptureInput_Changed">
            <ComboBoxItem Content="Custom Strategy draft" Tag="strategy_draft" IsSelected="True" />
            <ComboBoxItem Content="Managed Module preset" Tag="module_preset" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
          <TextBlock Text="ID" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
          <TextBox x:Name="IdBox" TextChanged="CaptureInput_Changed" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" x:Name="TierPanel">
          <TextBlock Text="TIER" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
          <TextBox x:Name="TierBox" Text="19" TextChanged="CaptureInput_Changed" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
          <TextBlock Text="DISPLAY NAME" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
          <TextBox x:Name="DisplayNameBox" TextChanged="CaptureInput_Changed" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" x:Name="BasePanel" Margin="0,0,0,8">
          <TextBlock Text="COMPARE WITH BASE (comparison only; unresolved fields are not inherited)" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
          <ComboBox x:Name="BaseBox" SelectionChanged="CaptureInput_Changed" DisplayMemberPath="Label" />
        </StackPanel>
        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" x:Name="DifferenceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="150" FontFamily="Consolas" FontSize="10" Text="Review captured-versus-Base differences before saving a Strategy draft." />
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Saving creates a new inactive artifact. It never publishes, selects, activates, queues, applies, or changes control authority." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Grid.Column="1" Content="Close" Click="Close_Click" Margin="3" />
      <Button Grid.Column="2" x:Name="TryAgainButton" Content="Try capture again" Click="TryAgain_Click" Margin="3" Visibility="Collapsed" />
      <Button Grid.Column="3" x:Name="CancelCaptureButton" Content="Cancel capture" Click="CancelCapture_Click" Style="{StaticResource DangerButton}" Margin="3" />
      <Button Grid.Column="4" x:Name="ReviewButton" Content="Review differences" Click="Review_Click" Margin="3" IsEnabled="False" />
      <Button Grid.Column="5" x:Name="SaveButton" Content="Save new artifact" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="3" IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
