<Window x:Class="TheTower.ControlSurface.StrategyHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategy Publication History"
        Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E16" Foreground="#EDF2F7"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Immutable Strategy History" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Review custom Strategy revisions and retired lineages. Restore publishes a new latest revision for the next active boundary or stopped-process Start, without switching the current battle."
                 Foreground="#93A4BB" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#111827" BorderBrush="#263349"
              BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="CUSTOM LINEAGES" Foreground="#62D5FF"
                     FontSize="11" FontWeight="Bold" Margin="4,2,4,7" />
          <ListBox Grid.Row="1" x:Name="LineagesList"
                   AutomationProperties.Name="Strategy history lineages"
                   Background="#0D1420" BorderBrush="#263349"
                   Foreground="#EDF2F7"
                   SelectionChanged="LineagesList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="7,6">
                  <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                             FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Id, Mode=OneWay}"
                             Foreground="#93A4BB" FontSize="11" />
                  <TextBlock Text="{Binding StatusLabel, Mode=OneWay}"
                             Foreground="#F1BF5B" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <Border Grid.Column="2" Background="#111827" BorderBrush="#263349"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="LineageTitle" Text="Select a custom lineage"
                     FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ListView Grid.Row="1" x:Name="RevisionsList"
                    AutomationProperties.Name="Immutable Strategy revisions"
                    Background="#0D1420" BorderBrush="#263349"
                    Foreground="#EDF2F7"
                    SelectionChanged="RevisionsList_SelectionChanged">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Revision" Width="150"
                                DisplayMemberBinding="{Binding VersionLabel, Mode=OneWay}" />
                <GridViewColumn Header="Published" Width="190"
                                DisplayMemberBinding="{Binding PublishedAt, Mode=OneWay}" />
                <GridViewColumn Header="Pinned Base" Width="150"
                                DisplayMemberBinding="{Binding BaseLabel, Mode=OneWay}" />
                <GridViewColumn Header="Origin" Width="175"
                                DisplayMemberBinding="{Binding PublicationOrigin, Mode=OneWay}" />
                <GridViewColumn Header="Validation" Width="210"
                                DisplayMemberBinding="{Binding ValidationLabel, Mode=OneWay}" />
              </GridView>
            </ListView.View>
          </ListView>

          <TextBlock Grid.Row="2" Text="REVISION REVIEW" Foreground="#62D5FF"
                     FontSize="10" FontWeight="Bold" Margin="2,12,2,6" />
          <TextBox Grid.Row="3" x:Name="ReviewText"
                   Text="Select a revision to inspect its immutable metadata and fingerprints."
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   Background="#0D1420" Foreground="#DCE7F5" BorderBrush="#263349"
                   Padding="10" />
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Loading immutable history..."
               Foreground="#93A4BB" TextWrapping="Wrap" Margin="2,0,2,10" />

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Historical review does not write. Restore does not Pause, restart, or switch the current battle."
                 Foreground="#93A4BB" FontSize="11" VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh"
              Click="Refresh_Click" />
      <Button Grid.Column="2" x:Name="CompareButton" Content="Compare with latest"
              Click="Compare_Click" IsEnabled="False" />
      <Button Grid.Column="3" Content="Close" Click="Close_Click" />
      <Button Grid.Column="4" x:Name="RestoreButton"
              Content="Restore as new revision..."
              Click="Restore_Click" Style="{StaticResource PrimaryButton}"
              IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
