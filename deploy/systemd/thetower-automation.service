[Unit]
Description=TheTower automation runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/python/TheTower
EnvironmentFile=-%h/.config/thetower/automation-adb.env
EnvironmentFile=-%h/.config/thetower/cell-balance.env
EnvironmentFile=-%h/.config/thetower/player-save-audit.env
ExecStart=%h/dev/python/TheTower/.venv/bin/python %h/dev/python/TheTower/main.py
KillSignal=SIGINT
TimeoutStopSec=30
Restart=no
Environment=PYTHONUNBUFFERED=1
Environment=THETOWER_ADB_CONNECTION_OWNER=control-surface

[Install]
WantedBy=default.target
